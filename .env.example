# ============================================
# 环境变量配置 - 复制为 .env 后填入真实值
# 用法: cp .env.example .env   (或直接运行 ./start.sh 会自动复制)
# 注意: .env 已被 .gitignore 忽略，不会提交到 git
# ============================================

# --- 方式1: Claude API (从 https://console.anthropic.com 获取) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# AI_MODEL=claude-sonnet-4-20250514

# --- 方式2: OpenAI 兼容接口 (DeepSeek / 千问 / 等) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# 说明: 两种方式填一个即可，都填了优先用 Claude。
# 都不填也能跑 —— 使用内置演示数据，完整流程可通。

# --- Redis (预留配置，当前代码未使用，可不填) ---
# REDIS_URL=redis://localhost:6379/0

# --- 上传/输出目录 (默认项目下的 uploads / outputs) ---
# UPLOAD_DIR=./uploads
# OUTPUT_DIR=./outputs
